# Resend API Key for sending emails
# Get your API key from: https://resend.com/api-keys
# Sign up at: https://resend.com
NUXT_RESEND_API_KEY=your_resend_api_key_here

# OG Image Secret (for consistent image URLs across deployments)
# Generate one with: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=your_og_image_secret_here
